#cloud-config
hostname: ${hostname}
preserve_hostname: false
package_update: true
packages:
  - python3
  - python3-apt
  - curl
  - gnupg
  - ca-certificates
%{ if is_edge ~}
  - wireguard
  - nftables
%{ endif ~}
write_files:
  - path: /opt/minilab2/segment
    content: "${segment}\n"
%{ if is_edge ~}
  - path: /etc/wireguard/wg0.conf
    permissions: "0600"
    content: |
      [Interface]
      Address = 10.97.0.1/24
      ListenPort = 51820
      PrivateKey = ${wg_server_privkey}
      PostUp = sysctl -w net.ipv4.ip_forward=1; iptables -t nat -A POSTROUTING -s 10.97.0.0/24 -o eth1 -j MASQUERADE; iptables -A FORWARD -i wg0 -j ACCEPT; iptables -A FORWARD -o wg0 -j ACCEPT
      PostDown = iptables -t nat -D POSTROUTING -s 10.97.0.0/24 -o eth1 -j MASQUERADE; iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -j ACCEPT
      [Peer]
      PublicKey = ${wg_client_pubkey}
      AllowedIPs = 10.97.0.2/32
%{ endif ~}
runcmd:
  - mkdir -p /opt/minilab2
%{ if is_edge ~}
  - sysctl -w net.ipv4.ip_forward=1
  - sed -i 's/#\?net.ipv4.ip_forward.*/net.ipv4.ip_forward=1/' /etc/sysctl.conf
  - systemctl enable --now wg-quick@wg0
%{ endif ~}
